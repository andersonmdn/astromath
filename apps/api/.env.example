# URL usada pelo runtime/app (pooler do Supabase — PgBouncer, porta 6543)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connect_timeout=15"

# URL usada pelo Prisma CLI (migrate, generate, validate) — conexão direta, sem pooler
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Auth
JWT_SECRET=mude_para_uma_string_aleatoria_longa
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
