generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id          String   @id @default(cuid())
  name        String   @unique
  pin         String?  // hash bcrypt — null se conta GitHub pura
  githubId    String?  @unique
  githubLogin String?  // username GitHub para exibição
  createdAt   DateTime @default(now())

  matchesAsP1 Match[] @relation("Player1")
  matchesAsP2 Match[] @relation("Player2")
  wins        Match[] @relation("Winner")
}

model Match {
  id         String    @id @default(cuid())
  roomId     String
  player1Id  String
  player2Id  String
  winnerId   String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  player1 Player  @relation("Player1", fields: [player1Id], references: [id])
  player2 Player  @relation("Player2", fields: [player2Id], references: [id])
  winner  Player? @relation("Winner", fields: [winnerId], references: [id])
}
